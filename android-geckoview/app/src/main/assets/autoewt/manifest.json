{
  "manifest_version": 2,
  "name": "AutoEwt Gecko Bridge",
  "version": "0.1.0",
  "description": "Native bridge for the AutoEwt GeckoView prototype.",
  "browser_specific_settings": {
    "gecko": {
      "id": "autoewt-geckoview@local"
    }
  },
  "permissions": [
    "<all_urls>",
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
